// Prisma schema do ConectVet

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLINICA
  PROFISSIONAL
  ADMIN
}

enum Categoria {
  VETERINARIO_CLINICO
  VETERINARIO_ESPECIALISTA
  ESTAGIARIO
  AUXILIAR
}

enum VagaStatus {
  ABERTA
  PREENCHIDA
  CONCLUIDA
  CANCELADA
}

enum CandidaturaStatus {
  PENDENTE
  ACEITO
  RECUSADO
  // Profissional aceito que desistiu antes da data do plantão — diferente de
  // RECUSADO (que é a clínica recusando) e diferente de não comparecer
  // (que só se sabe depois do plantão já ter passado, e não reabre a vaga).
  DESISTIU
}

enum PagamentoStatus {
  // Candidatura aceita, clínica ainda não escolheu Pix/Cartão.
  AGUARDANDO_COBRANCA
  // Cobrança enviada ao gateway (fake, por enquanto), esperando confirmação.
  PROCESSANDO
  // Recusado / expirado — clínica pode tentar de novo ou desistir da contratação.
  FALHOU
  // Cobrança aprovada, valor retido.
  RETIDO
  // Presença confirmada, mas o profissional ainda não configurou onde receber.
  LIBERADO_PENDENTE
  // Valor transferido ao profissional.
  LIBERADO
  // Devolvido à clínica — não compareceu ou desistência.
  REEMBOLSADO
  // Nenhum valor chegou a ser cobrado (desistência antes da cobrança ser aprovada).
  CANCELADO
  // Contestação/chargeback depois de já Liberado — resolução manual (fora de escopo por enquanto).
  EM_DISPUTA
}

enum FormaPagamento {
  PIX
  CARTAO
}

enum MotivoReembolso {
  NAO_COMPARECEU
  DESISTENCIA
}

enum ContaRecebimentoStatus {
  NAO_CONFIGURADA
  EM_ANALISE
  APROVADA
  RECUSADA
}

enum TipoChavePix {
  CPF
  EMAIL
  TELEFONE
  ALEATORIA
}

enum AvaliacaoAutor {
  CLINICA
  PROFISSIONAL
}

enum NotificacaoTipo {
  CANDIDATURA_ACEITA
  CANDIDATURA_RECUSADA
  VAGA_PREENCHIDA_OUTRO
  PAGAMENTO_LIBERADO
  AVALIACAO_RECEBIDA
  PROFISSIONAL_DESISTIU
  VAGA_REABERTA
  MARCADO_NAO_COMPARECEU
  PAGAMENTO_LIBERADO_PENDENTE
  PROBLEMA_REPORTADO
  // Clínica convidando um favorito (ou um bem avaliado do ranking) pra se candidatar
  // a uma vaga aberta — ver VagasService#convidar.
  CONVITE_PARA_VAGA
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  senhaHash String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Login fica bloqueado enquanto emailVerificado = false. O token é gerado
  // no cadastro e a cada reenvio, e some assim que a confirmação é concluída.
  emailVerificado        Boolean   @default(false)
  emailVerificacaoToken  String?   @unique
  emailVerificacaoExpira DateTime?

  clinica       Clinica?
  profissional  Profissional?
  notificacoes  Notificacao[]

  @@map("users")
}

model Clinica {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  nome                   String
  cnpj                   String @unique
  inscricaoEstadual      String
  responsavelTecnicoNome String?
  responsavelTecnicoCrmv String?

  telefone String?

  cep         String?
  estado      String
  cidade      String
  bairro      String?
  rua         String
  numero      String
  complemento String?

  alvaraUrl      String
  fotosEstrutura Json    @default("[]")
  logoUrl        String?
  // Texto livre de apresentação, mostrado no perfil público da clínica
  // (acessado a partir da foto/nome da clínica em Detalhes da vaga).
  sobre          String?
  planosSaude    String?
  sistemas       String?
  observacoes    String?

  vagas     Vaga[]
  favoritos Favorito[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("clinicas")
}

model Profissional {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  nome      String
  documento String    @unique // CPF ou CNPJ
  funcao    Categoria

  // Só se aplica quando funcao = VETERINARIO_ESPECIALISTA.
  especialidade String?

  telefone       String?
  dataNascimento DateTime?

  // Só se aplica quando funcao = VETERINARIO_CLINICO ou VETERINARIO_ESPECIALISTA.
  crmv String?

  tipoComprovacao String
  comprovanteUrl  String
  idDocUrls       String[]
  curriculoUrl    String?
  fotoUrl         String?

  // Só se aplica a veterinários já formados (VETERINARIO_CLINICO ou VETERINARIO_ESPECIALISTA).
  areaAtuacao        String?
  regioesAtendimento String
  observacoes        String?

  candidaturas      Candidatura[]
  avaliacoes        Avaliacao[]
  contaRecebimento  ContaRecebimento?
  favoritadoPor     Favorito[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profissionais")
}

// Profissionais que uma clínica marcou como favorito — alimenta a seção "Profissionais
// favoritos" da Home e o botão de convidar direto pra uma vaga aberta (ver
// VagasService#convidar, que exige a mesma categoria da vaga, favoritado ou não).
model Favorito {
  id             String       @id @default(cuid())
  clinicaId      String
  clinica        Clinica      @relation(fields: [clinicaId], references: [id], onDelete: Cascade)
  profissionalId String
  profissional   Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([clinicaId, profissionalId])
  @@map("favoritos")
}

model ContaRecebimento {
  id             String       @id @default(cuid())
  profissionalId String       @unique
  profissional   Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)

  status       ContaRecebimentoStatus @default(NAO_CONFIGURADA)
  tipoChavePix TipoChavePix?
  chavePix     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contas_recebimento")
}

model Vaga {
  id        String  @id @default(cuid())
  clinicaId String
  clinica   Clinica @relation(fields: [clinicaId], references: [id], onDelete: Cascade)

  // Prefixo pela categoria (VC/VE/AU/ES) + 4 dígitos, ex. "VC-4821" — mostrado igual pra
  // clínica, profissional e visitante deslogado. Opcional só porque vagas criadas antes
  // dessa coluna existir ficam sem código pra sempre (não vale a pena inventar um
  // retroativamente); toda vaga nova sempre ganha um, ver VagasService#gerarCodigo.
  codigo String? @unique

  categoria Categoria

  cep         String?
  estado      String
  cidade      String
  bairro      String?
  rua         String
  numero      String
  complemento String?

  data       DateTime @db.Date
  horaInicio String
  horaFim    String
  valor      Decimal  @db.Decimal(10, 2)
  descricao  String?

  status VagaStatus @default(ABERTA)

  candidaturas  Candidatura[]
  pagamentos    Pagamento[]
  notificacoes  Notificacao[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vagas")
}

model Candidatura {
  id             String       @id @default(cuid())
  vagaId         String
  vaga           Vaga         @relation(fields: [vagaId], references: [id], onDelete: Cascade)
  profissionalId String
  profissional   Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)

  status CandidaturaStatus @default(PENDENTE)

  // Código de 4 dígitos gerado quando a clínica aceita — ela passa esse
  // código pro profissional na chegada, e ele digita no app pra confirmar
  // presença (substitui o antigo botão manual "Confirmar presença" da
  // clínica). `checkInEm` fica null até o check-in acontecer.
  codigoCheckIn String?
  checkInEm     DateTime?

  pagamento  Pagamento?
  avaliacoes Avaliacao[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vagaId, profissionalId])
  @@map("candidaturas")
}

model Pagamento {
  id            String      @id @default(cuid())
  vagaId        String
  vaga          Vaga        @relation(fields: [vagaId], references: [id], onDelete: Cascade)
  candidaturaId String      @unique
  candidatura   Candidatura @relation(fields: [candidaturaId], references: [id], onDelete: Cascade)

  // valorLiquido = o que o profissional recebe; taxa = comissão da ConectVet (5%);
  // valorBruto = valorLiquido + taxa (o que já era cobrado da clínica antes do gateway).
  valorBruto   Decimal @db.Decimal(10, 2)
  taxa         Decimal @db.Decimal(10, 2)
  valorLiquido Decimal @db.Decimal(10, 2)

  status PagamentoStatus @default(AGUARDANDO_COBRANCA)

  // Só preenchidos depois que a clínica escolhe a forma de pagamento (POST .../cobrar).
  formaPagamento FormaPagamento?
  taxaGateway    Decimal         @default(0) @db.Decimal(10, 2)
  // valorTotal = valorBruto + taxaGateway — o que a clínica efetivamente paga.
  valorTotal     Decimal?        @db.Decimal(10, 2)
  motivoFalha    String?

  motivoReembolso MotivoReembolso?
  reembolsadoEm   DateTime?

  // Preenchidos quando a clínica reporta um problema (ausência, atraso,
  // comportamento etc.) em vez do check-in confirmar a presença sozinho —
  // status vira EM_DISPUTA e a análise/decisão é manual, fora do app, por
  // enquanto (mesma ressalva já documentada acima para EM_DISPUTA).
  disputaMotivo    String?
  disputaDescricao String?
  disputaAbertaEm  DateTime?

  createdAt  DateTime  @default(now())
  liberadoEm DateTime?

  @@index([vagaId])
  @@map("pagamentos")
}

model Notificacao {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tipo  NotificacaoTipo
  texto String

  // Só preenchido em CONVITE_PARA_VAGA — é o que permite o botão "Ver detalhes da
  // vaga" levar direto pra ela. onDelete SetNull: se a vaga sumir, a notificação
  // continua existindo (só perde o link), não faz sentido apagá-la em cascata.
  vagaId String?
  vaga   Vaga?   @relation(fields: [vagaId], references: [id], onDelete: SetNull)

  lida Boolean @default(false)

  createdAt DateTime @default(now())

  @@map("notificacoes")
}

model Avaliacao {
  id             String       @id @default(cuid())
  candidaturaId  String
  candidatura    Candidatura  @relation(fields: [candidaturaId], references: [id], onDelete: Cascade)
  profissionalId String
  profissional   Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)

  autor      AvaliacaoAutor
  nota       Int
  comentario String?

  createdAt DateTime @default(now())

  @@unique([candidaturaId, autor])
  @@map("avaliacoes")
}
