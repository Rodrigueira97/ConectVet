# Neon: pegue as duas URLs no dashboard do projeto.
# DATABASE_URL = connection string "Pooled connection" (host com "-pooler")
# DIRECT_URL   = connection string direta (sem "-pooler"), usada só p/ migrations
# Em dev local (sem pooler) pode deixar as duas iguais.
DATABASE_URL="postgresql://user:password@localhost:5432/conectvet?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/conectvet?schema=public"

JWT_SECRET="troque-este-valor-em-producao"
JWT_EXPIRES_IN="7d"
PORT=3333

# URL do frontend em produção, usada para restringir o CORS.
# Em branco/ausente libera qualquer origem (ok para dev local).
CORS_ORIGIN=""

# Credenciais do admin criado pelo seed (ajuste antes de rodar em produção)
ADMIN_EMAIL="admin@conectvet.com"
ADMIN_SENHA="troque-esta-senha"

# Cloudflare R2 (armazenamento de uploads — logo, fotos, documentos).
# R2_ACCOUNT_ID: painel do Cloudflare > R2 Object Storage (aparece na barra lateral)
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY: R2 > Manage R2 API Tokens > Create API Token
# R2_BUCKET_NAME: nome do bucket criado
# R2_PUBLIC_URL: URL pública do bucket (subdomínio r2.dev ou domínio customizado), sem "/" no final
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# WhatsApp Business Platform (Cloud API da Meta) — envia toda notificação
# criada em NotificacoesService.criar() também por WhatsApp, se o usuário
# tiver telefone cadastrado. Sem essas duas variáveis, o envio é pulado
# silenciosamente (o sininho no app continua funcionando normal).
#
# Como conseguir:
# 1. developers.facebook.com > Meus Apps > Criar App > tipo "Negócios"
# 2. Adicionar o produto "WhatsApp" ao app
# 3. WHATSAPP_PHONE_NUMBER_ID: aparece em WhatsApp > Introdução (o número de
#    teste gratuito da Meta já vem pronto pra usar, sem precisar verificar
#    conta comercial ainda)
# 4. WHATSAPP_ACCESS_TOKEN: token temporário na mesma tela (24h) pra testar;
#    depois trocar por um token permanente de "usuário do sistema" em
#    Configurações do Negócio > Usuários do sistema
# 5. É preciso criar (e ter aprovado pela Meta) um template de mensagem
#    chamado "notificacao_generica" — ver api/scripts/whatsapp-template.ts
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
